{
  "name": "nextjs-vitest-playwright",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "drizzle:generate": "dotenv -e .env.development -- drizzle-kit generate --config=./drizzle.config.ts",
    "drizzle:migrate:dev": "dotenv -e .env.development -- drizzle-kit migrate --config=./drizzle.config.ts",
    "drizzle:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate --config=./drizzle.config.ts",
    "dev:test": "dotenv -e .env.e2e -- next dev",
    "start:test": "dotenv -e .env.e2e -- next start",
    "test": "dotenv -e .env.test -- vitest run --reporter=verbose",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "dotenv -e .env.test -- vitest --bail 1",
    "test:unit": "dotenv -e .env.test -- vitest run --exclude 'src/**/*.{test,e2e}.{ts,tsx}' --fileParallelism",
    "test:unit:watch": "dotenv -e .env.test -- vitest --exclude 'src/**/*.{test,e2e}.{ts,tsx}' --fileParallelism",
    "test:int": "dotenv -e .env.test -- vitest run --exclude 'src/**/*.{spec,e2e}.{ts,tsx}' --no-file-parallelism",
    "test:int:watch": "dotenv -e .env.test -- vitest --exclude 'src/**/*.{spec,e2e}.{ts,tsx}' --no-file-parallelism",
    "test:cov": "dotenv -e .env.test -- vitest run --coverage --no-file-parallelism",
    "test:e2e": "dotenv -e .env.e2e -- playwright test --reporter null",
    "test:e2e:repeat": "dotenv -e .env.e2e -- playwright test -g 'should disable the button while creating the TODO.' --reapeat-each 100",
    "test:e2e:headed": "dotenv -e .env.e2e -- playwright test --headed --reporter null",
    "test:e2e:debug": "dotenv -e .env.e2e -- playwright test --debug --reporter null",
    "test:e2e:ui": "dotenv -e .env.e2e -- playwright test --ui",
    "test:e2e:report": "dotenv -e .env.e2e -- playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^0.544.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-essentials": "~8.6.14",
    "@storybook/nextjs": "~8.6.14",
    "@storybook/react": "~8.6.14",
    "@storybook/test": "~8.6.14",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "^27.0.0",
    "storybook": "~8.6.14",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "webpack": "5.101.2"
  }
}
